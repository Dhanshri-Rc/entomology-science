# ============================================================
# SERVER
# ============================================================
NODE_ENV=development
PORT=5000

# ============================================================
# MONGODB
# Use MongoDB Atlas connection string in production.
# Example:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/entomology?retryWrites=true&w=majority
# ============================================================
MONGODB_URI=mongodb://127.0.0.1:27017/entomology

# ============================================================
# JWT AUTH
# JWT_SECRET must be a long, random, private string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================================
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1d
JWT_COOKIE_NAME=entomo_admin_token

# ============================================================
# CLIENT / CORS
# Comma-separated list of allowed frontend origins.
# ============================================================
CLIENT_URL=http://localhost:5173

# ============================================================
# INITIAL ADMIN SEED
# Used only once by `npm run seed:admin`. Change the password
# immediately after first login in production.
# ============================================================
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@entomologyscience.org
ADMIN_PASSWORD=12345678

# ============================================================
# UPLOAD LIMITS (in MB) - optional overrides
# ============================================================
MANUSCRIPT_MAX_SIZE_MB=10
COVER_LETTER_MAX_SIZE_MB=5
